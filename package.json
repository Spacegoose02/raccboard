{
  "name": "rackboard",
  "version": "1.2.0",
  "description": "Raccboard - a self-hosted Kanban board with lists, sublists and themes.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "smoke": "node scripts/smoke.js",
    "icons": "node scripts/icons.js",
    "android:sync": "npm run build && cap sync android",
    "android:apk": "node scripts/apk.js debug",
    "android:open": "cap open android",
    "smoke:oidc": "node scripts/smoke-oidc.js",
    "smoke:google": "node scripts/smoke-google.js",
    "smoke:email": "node scripts/smoke-email.js",
    "smoke:cli": "node scripts/smoke-cli.js",
    "smoke:features": "node scripts/smoke-features.js"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "better-sqlite3": "^13.0.3",
    "express": "^5.3.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.1.6",
    "openid-client": "^6.8.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "sharp": "^0.35.5",
    "vite": "^8.3.4"
  }
}
